From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: iwls <iwls@localhost>
Date: Wed, 7 Oct 2026 16:07:30 +0000
Subject: [PATCH] build: FEX iOS configure names the target processor

A cross build for iOS leaves CMAKE_SYSTEM_PROCESSOR empty, and FEX's
CMakeLists stops with "Unsupported processor type". A first configure
from a clean checkout (CI) needs it set to arm64.
---
 build/fex-ios/build.sh | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/build/fex-ios/build.sh b/build/fex-ios/build.sh
index ce3cc60..da074c8 100755
--- a/build/fex-ios/build.sh
+++ b/build/fex-ios/build.sh
@@ -6,7 +6,7 @@ set -eu
 R="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
 B="$R/FEX/build-ios"
 if [ ! -f "$B/CMakeCache.txt" ]; then
-    cmake -S "$R/FEX" -B "$B" -DCMAKE_SYSTEM_NAME=iOS -DCMAKE_OSX_ARCHITECTURES=arm64 \
+    cmake -S "$R/FEX" -B "$B" -DCMAKE_SYSTEM_NAME=iOS -DCMAKE_SYSTEM_PROCESSOR=arm64 -DCMAKE_OSX_ARCHITECTURES=arm64 \
         -DCMAKE_OSX_SYSROOT=iphoneos -DCMAKE_OSX_DEPLOYMENT_TARGET=17.0 -DCMAKE_BUILD_TYPE=Release \
         -DBUILD_TESTING=OFF -DBUILD_THUNKS=OFF -DBUILD_FEXCONFIG=OFF -DBUILD_FEX_LINUX_TESTS=OFF \
         -DENABLE_FEX_ALLOCATOR=OFF -DENABLE_ASSERTIONS=OFF -DENABLE_CLANG_THUNKS=ON -DENABLE_CCACHE=ON
-- 
