From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: iwls <iwls@localhost>
Date: Wed, 7 Oct 2026 15:30:53 +0000
Subject: [PATCH] App icon: Liquid Glass icon (Icon Composer)

MadeiraGlass.icon is a layered Icon Composer icon, so iOS 26 renders it
in Liquid Glass with its light, dark and tinted appearances: a glass
window with title-bar dots and a pointer over an ocean-blue gradient.
Original artwork. AppIcon-1024.png is a flat rendering of the same design
for the asset catalog's fallback.
---
 app/Madeira.xcodeproj/project.pbxproj         |   8 ++-
 .../AppIcon.appiconset/AppIcon-1024.png       | Bin 429496 -> 185037 bytes
 app/Madeira/MadeiraGlass.icon/Assets/Dots.svg |   3 +
 .../MadeiraGlass.icon/Assets/Plate.svg        |   4 ++
 .../MadeiraGlass.icon/Assets/Pointer.svg      |   3 +
 app/Madeira/MadeiraGlass.icon/icon.json       |  68 ++++++++++++++++++
 6 files changed, 84 insertions(+), 2 deletions(-)
 create mode 100644 app/Madeira/MadeiraGlass.icon/Assets/Dots.svg
 create mode 100644 app/Madeira/MadeiraGlass.icon/Assets/Plate.svg
 create mode 100644 app/Madeira/MadeiraGlass.icon/Assets/Pointer.svg
 create mode 100644 app/Madeira/MadeiraGlass.icon/icon.json

diff --git a/app/Madeira.xcodeproj/project.pbxproj b/app/Madeira.xcodeproj/project.pbxproj
index 9bdea6f..cb462a4 100644
--- a/app/Madeira.xcodeproj/project.pbxproj
+++ b/app/Madeira.xcodeproj/project.pbxproj
@@ -7,6 +7,7 @@
 	objects = {
 
 /* Begin PBXBuildFile section */
+		C1000101 /* MadeiraGlass.icon in Resources */ = {isa = PBXBuildFile; fileRef = C2000101 /* MadeiraGlass.icon */; };
 		C1000001 /* ArchiveImport.swift in Sources */ = {isa = PBXBuildFile; fileRef = C2000001 /* ArchiveImport.swift */; };
 		C1000002 /* MadeiraArchive.c in Sources */ = {isa = PBXBuildFile; fileRef = C2000002 /* MadeiraArchive.c */; };
 		C1000003 /* 7zAlloc.c in Sources */ = {isa = PBXBuildFile; fileRef = C2000003 /* 7zAlloc.c */; settings = {COMPILER_FLAGS = "-DZ7_PPMD_SUPPORT -w"; }; };
@@ -193,6 +194,7 @@
 /* End PBXCopyFilesBuildPhase section */
 
 /* Begin PBXFileReference section */
+		C2000101 /* MadeiraGlass.icon */ = {isa = PBXFileReference; lastKnownFileType = folder.iconcomposer.icon; path = MadeiraGlass.icon; sourceTree = "<group>"; };
 		C2000001 /* ArchiveImport.swift */ = {isa = PBXFileReference; lastKnownFileType = sourcecode.swift; name = "ArchiveImport.swift"; path = "ArchiveImport.swift"; sourceTree = "<group>"; };
 		C2000002 /* MadeiraArchive.c */ = {isa = PBXFileReference; lastKnownFileType = sourcecode.c.c; name = "MadeiraArchive.c"; path = "Archive/MadeiraArchive.c"; sourceTree = "<group>"; };
 		C2000003 /* 7zAlloc.c */ = {isa = PBXFileReference; lastKnownFileType = sourcecode.c.c; name = "7zAlloc.c"; path = "Archive/lzma/7zAlloc.c"; sourceTree = "<group>"; };
@@ -426,6 +428,7 @@
 		A4000002 /* Madeira */ = {
 			isa = PBXGroup;
 			children = (
+				C2000101 /* MadeiraGlass.icon */,
 				C2000001 /* ArchiveImport.swift */,
 				C2000002 /* MadeiraArchive.c */,
 				C2000003 /* 7zAlloc.c */,
@@ -713,6 +716,7 @@
 				A1000040 /* prefix-template.tar.gz in Resources */,
 				A1000094 /* cacert.pem in Resources */,
 				A1000910 /* Assets.xcassets in Resources */,
+				C1000101 /* MadeiraGlass.icon in Resources */,
 				B1000004 /* madeira-jit.js in Resources */,
 				B1000051 /* Madeira JIT.shortcut in Resources */,
 			);
@@ -960,7 +964,7 @@
 		A8000003 /* Debug */ = {
 			isa = XCBuildConfiguration;
 			buildSettings = {
-				ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon;
+				ASSETCATALOG_COMPILER_APPICON_NAME = MadeiraGlass;
 				CODE_SIGN_ENTITLEMENTS = Madeira/Madeira.entitlements;
 				CODE_SIGN_IDENTITY = "Apple Development";
 				CODE_SIGN_STYLE = Automatic;
@@ -1012,7 +1016,7 @@
 		A8000004 /* Release */ = {
 			isa = XCBuildConfiguration;
 			buildSettings = {
-				ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon;
+				ASSETCATALOG_COMPILER_APPICON_NAME = MadeiraGlass;
 				CODE_SIGN_ENTITLEMENTS = Madeira/Madeira.entitlements;
 				CODE_SIGN_STYLE = Automatic;
 				CURRENT_PROJECT_VERSION = 4;
