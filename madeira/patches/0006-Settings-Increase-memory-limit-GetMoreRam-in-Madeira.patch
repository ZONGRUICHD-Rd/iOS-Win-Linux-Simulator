+
+impl V1ErrorDetail {
+    pub fn to_error(&self, url: String) -> crate::appleid::plume::Error {
+        let message = self
+            .detail
+            .clone()
+            .or(self.title.clone())
+            .unwrap_or_else(|| "Unknown API error".to_string());
+
+        crate::appleid::plume::Error::DeveloperApi {
+            url,
+            result_code: self.result_code,
+            http_code: self.status.parse().ok(),
+            message,
+        }
+    }
+}
