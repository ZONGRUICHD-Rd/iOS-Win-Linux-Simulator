+++ b/app/Madeira/MadeiraAppleID.h
@@ -0,0 +1,40 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Madeira Converter Exception: see LICENSE-EXCEPTION.md
+//
+// Apple ID sign-in for the memory-limit tool (MemoryLimitTool.swift), linked
+// from libmadeira_rppairing.a. Keep in step with
+// build/rppairing-ios/src/appleid/ffi.rs.
+
+#ifndef MADEIRA_APPLEID_H
+#define MADEIRA_APPLEID_H
+
+#include <stdint.h>
+
+typedef struct MadeiraAppleID MadeiraAppleID;
+
+enum {
+    MADEIRA_APPLEID_NEEDS_CODE = 1,         // {"method":"device"|"sms","phones":[{"id":1,"number":"..."}]}
+    MADEIRA_APPLEID_SIGNED_IN = 2,          // {"teams":[{"id":"...","name":"...","type":"..."}]}
+    MADEIRA_APPLEID_APP_IDS = 3,            // {"appIDs":[{"identifier":"...","name":"..."}]}
+    MADEIRA_APPLEID_CAPABILITY_ENABLED = 4, // {"identifier":"...","capability":"..."}
+    MADEIRA_APPLEID_ERROR = 9,              // {"message":"..."}
+};
+
+/// Called on the session's own thread; `json` is valid for the call only.
+typedef void (*MadeiraAppleIDEventCallback)(int32_t kind, const char *json, void *context);
+
+/// anisette_dir: a writable folder for the anisette identity. anisette_url:
+/// a SideStore Anisette v3 server, NULL for the default. NULL on failure.
+MadeiraAppleID *madeira_appleid_new(const char *anisette_dir, const char *anisette_url,
+                                    MadeiraAppleIDEventCallback callback, void *context);
+void madeira_appleid_sign_in(const MadeiraAppleID *session, const char *apple_id, const char *password);
+void madeira_appleid_submit_code(const MadeiraAppleID *session, const char *code);
+void madeira_appleid_request_sms(const MadeiraAppleID *session, uint32_t phone_id);
+void madeira_appleid_cancel_code(const MadeiraAppleID *session);
+void madeira_appleid_list_app_ids(const MadeiraAppleID *session, const char *team);
+void madeira_appleid_enable_capability(const MadeiraAppleID *session, const char *team,
+                                       const char *bundle_id, const char *capability);
+/// Blocks until the current request ends; call it off the main thread.
+void madeira_appleid_free(MadeiraAppleID *session);
+
+#endif
diff --git a/app/Madeira/MemoryLimitTool.swift b/app/Madeira/MemoryLimitTool.swift
new file mode 100644
index 0000000..477142a
--- /dev/null
+++ b/app/Madeira/MemoryLimitTool.swift
@@ -0,0 +1,298 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Madeira Converter Exception: see LICENSE-EXCEPTION.md
+//
+// GetMoreRam inside Madeira: sign in to the Apple ID Madeira was sideloaded
+// with and turn on the Increased Memory Limit capability for Madeira's App ID
+// (or another App ID of the account), as Xcode would. The sideloader then
+// adds com.apple.developer.kernel.increased-memory-limit at the next
+// reinstall. The sign-in runs in libmadeira_rppairing.a (MadeiraAppleID.h,
+// build/rppairing-ios/src/appleid); the password is passed to it for the
+// sign-in and never stored.
+
+import SwiftUI
+
+/// Holds the tool weakly for the C callback, which may outlive it.
+final class MemoryLimitEventSink: @unchecked Sendable {
+    weak var tool: MemoryLimitTool?
+}
+
+@MainActor
+final class MemoryLimitTool: ObservableObject {
+    struct Team: Identifiable, Hashable {
+        let id: String
+        let name: String
+    }
+    struct AppIDItem: Identifiable, Hashable {
+        let identifier: String
+        let name: String
+        var id: String { identifier }
+    }
+    struct Phone: Identifiable, Hashable {
+        let id: UInt32
+        let number: String
+    }
+    enum Phase: Equatable {
+        case signedOut, signingIn, needsCode(sms: Bool), signedIn
+    }
+
+    static let capability = "INCREASED_MEMORY_LIMIT"
+    /// Madeira's App ID as installed (sideloaders rename it, e.g. adding the team ID).
+    static var ownIdentifier: String { Bundle.main.bundleIdentifier ?? "" }
+
+    @Published var phase: Phase = .signedOut
+    @Published var phones: [Phone] = []
+    @Published var teams: [Team] = []
+    @Published var team: Team?
+    @Published var appIDs: [AppIDItem] = []
+    @Published var loadingAppIDs = false
+    @Published var enabling: Set<String> = []
+    @Published var enabled: Set<String> = []
+    @Published var error: String?
+
+    private var session: OpaquePointer?
+    private var sink: Unmanaged<MemoryLimitEventSink>?
+
+    deinit {
+        guard let session else { return }
+        let sink = self.sink
+        // Freeing waits for a request in flight; never on the main thread.
+        DispatchQueue.global(qos: .utility).async {
+            madeira_appleid_free(session)
+            sink?.release()
+        }
+    }
+
+    private func ensureSession() -> OpaquePointer? {
+        if let session { return session }
+        let dir = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask)[0]
+            .appendingPathComponent("anisette", isDirectory: true)
+        try? FileManager.default.createDirectory(at: dir, withIntermediateDirectories: true)
+        let box = MemoryLimitEventSink()
+        box.tool = self
+        let retained = Unmanaged.passRetained(box)
+        let created = madeira_appleid_new(dir.path, nil, { kind, json, context in
+            guard let json, let context else { return }
+            let text = String(cString: json)
+            let box = Unmanaged<MemoryLimitEventSink>.fromOpaque(context).takeUnretainedValue()
+            Task { @MainActor in box.tool?.handle(kind: Int(kind), json: text) }
+        }, retained.toOpaque())
+        guard let created else {
+            retained.release()
+            error = String(localized: "The sign-in could not start.")
+            return nil
+        }
+        session = created
+        sink = retained
+        return created
+    }
+
+    func signIn(appleID: String, password: String) {
+        guard let s = ensureSession() else { return }
+        error = nil
+        phase = .signingIn
+        madeira_appleid_sign_in(s, appleID.trimmingCharacters(in: .whitespaces), password)
+    }
+
+    func submit(code: String) {
+        guard let session else { return }
+        phase = .signingIn
+        madeira_appleid_submit_code(session, code.filter(\.isNumber))
+    }
+
+    func requestSMS(_ phone: Phone) {
+        guard let session else { return }
+        phase = .signingIn
+        madeira_appleid_request_sms(session, phone.id)
+    }
+
+    func cancelCode() {
+        guard let session else { return }
+        madeira_appleid_cancel_code(session)
+    }
+
+    func select(_ team: Team) {
+        guard let session else { return }
+        self.team = team
+        appIDs = []
+        loadingAppIDs = true
+        madeira_appleid_list_app_ids(session, team.id)
+    }
+
+    func enable(_ item: AppIDItem) {
+        guard let session, let team else { return }
+        enabling.insert(item.identifier)
+        madeira_appleid_enable_capability(session, team.id, item.identifier, Self.capability)
+    }
+
+    fileprivate func handle(kind: Int, json: String) {
+        let body = (try? JSONSerialization.jsonObject(with: Data(json.utf8))) as? [String: Any] ?? [:]
+        switch kind {
+        case Int(MADEIRA_APPLEID_NEEDS_CODE):
+            phones = (body["phones"] as? [[String: Any]] ?? []).compactMap { p in
+                guard let id = p["id"] as? Int, let number = p["number"] as? String else { return nil }
+                return Phone(id: UInt32(id), number: number)
+            }
+            phase = .needsCode(sms: body["method"] as? String == "sms")
+        case Int(MADEIRA_APPLEID_SIGNED_IN):
+            teams = (body["teams"] as? [[String: Any]] ?? []).compactMap { t in
+                guard let id = t["id"] as? String else { return nil }
+                return Team(id: id, name: t["name"] as? String ?? id)
+            }
+            phase = .signedIn
+            if let first = teams.first { select(first) }
+        case Int(MADEIRA_APPLEID_APP_IDS):
+            let own = Self.ownIdentifier
+            appIDs = (body["appIDs"] as? [[String: Any]] ?? []).compactMap { a in
+                guard let identifier = a["identifier"] as? String else { return nil }
+                return AppIDItem(identifier: identifier, name: a["name"] as? String ?? identifier)
+            }.sorted { a, b in
+                if (a.identifier == own) != (b.identifier == own) { return a.identifier == own }
+                return a.name.localizedStandardCompare(b.name) == .orderedAscending
+            }
+            loadingAppIDs = false
+        case Int(MADEIRA_APPLEID_CAPABILITY_ENABLED):
+            if let identifier = body["identifier"] as? String {
+                enabling.remove(identifier)
+                enabled.insert(identifier)
+            }
+        default:
+            let message = body["message"] as? String ?? ""
+            enabling.removeAll()
+            loadingAppIDs = false
+            if phase != .signedIn { phase = .signedOut }
+            error = Self.describe(message)
+        }
+    }
+
+    private static func describe(_ message: String) -> String {
+        if message.contains("Bad 2FA") { return String(localized: "The verification code is not correct.") }
+        if message.contains("cancelled") { return String(localized: "Sign-in cancelled.") }
+        if message.contains("-22406") || message.contains("-20101") {
+            return String(localized: "The Apple ID or password is not correct.")
+        }
+        if message.lowercased().contains("anisette") || message.contains("Provisioning socket") {
+            return String(localized: "The anisette server could not be reached. Check the network and try again.") + "\n(\(message))"
+        }
+        return String(localized: "Apple's server returned an error.") + "\n(\(message))"
+    }
+}
+
+struct MemoryLimitView: View {
+    @StateObject private var tool = MemoryLimitTool()
+    @Environment(\.dismiss) private var dismiss
+    @AppStorage("madeira.memoryTool.appleID") private var appleID = ""
+    @State private var password = ""
+    @State private var code = ""
+    @State private var hasMemory = EntitlementStatus.check().increasedMemory
+
+    var body: some View {
+        NavigationStack {
+            Form {
+                Section {
+                    LabeledContent("Memory+") {
+                        Label(hasMemory ? "On" : "Off", systemImage: hasMemory ? "checkmark.circle.fill" : "xmark.circle.fill")
+                            .foregroundStyle(hasMemory ? .green : .red)
+                    }
+                } footer: {
+                    Text("Increased Memory Limit lets Madeira use more of this device's memory, which large programs need. A free Apple ID can turn it on for the App IDs it signs; this does what GetMoreRam does.")
+                }
+                switch tool.phase {
+                case .signedOut, .signingIn: signIn
+                case .needsCode(let sms): verification(sms: sms)
+                case .signedIn: appIDList
+                }
+            }
+            .navigationTitle("Increase memory limit")
+            .navigationBarTitleDisplayMode(.inline)
+            .toolbar { ToolbarItem(placement: .confirmationAction) { Button("Done") { dismiss() } } }
+            .alert("Memory limit", isPresented: Binding(get: { tool.error != nil }, set: { if !$0 { tool.error = nil } })) {
+                Button("OK", role: .cancel) {}
+            } message: { Text(tool.error ?? "") }
+        }
+    }
+
+    private var signIn: some View {
+        Section {
+            TextField("Apple ID", text: $appleID)
+                .textContentType(.username).keyboardType(.emailAddress)
+                .textInputAutocapitalization(.never).autocorrectionDisabled()
+            SecureField("Password", text: $password).textContentType(.password)
+            Button {
+                tool.signIn(appleID: appleID, password: password)
+            } label: {
+                HStack {
+                    Text("Sign in")
+                    if tool.phase == .signingIn { Spacer(); ProgressView() }
+                }
+            }
+            .disabled(appleID.isEmpty || password.isEmpty || tool.phase == .signingIn)
+        } header: {
+            Text("Apple ID used to sideload Madeira")
+        } footer: {
+            Text("The password is used only to sign in to Apple and is not saved. Apple's sign-in also needs anisette data, which Madeira gets from SideStore's anisette server (ani.sidestore.app); that server never sees your password.")
+        }
+    }
+
+    private func verification(sms: Bool) -> some View {
+        Section {
+            TextField("Verification code", text: $code)
+                .keyboardType(.numberPad).textContentType(.oneTimeCode)
+            Button("Verify") { tool.submit(code: code); code = "" }
+                .disabled(code.filter(\.isNumber).count < 6)
+            ForEach(tool.phones) { phone in
+                Button("Send a code by SMS to \(phone.number)") { tool.requestSMS(phone) }
+            }
+            Button("Cancel", role: .cancel) { tool.cancelCode() }
+        } header: {
+            Text("Two-factor authentication")
+        } footer: {
+            Text(sms ? "Enter the code sent by SMS." : "Enter the code shown on your other Apple devices.")
+        }
+    }
+
+    private var appIDList: some View {
+        Group {
+            if tool.teams.count > 1 {
+                Section {
+                    Picker("Team", selection: Binding(get: { tool.team }, set: { if let t = $0 { tool.select(t) } })) {
+                        ForEach(tool.teams) { Text($0.name).tag(Optional($0)) }
+                    }
+                }
+            }
+            Section {
+                if tool.loadingAppIDs {
+                    HStack { Text("Loading App IDs…"); Spacer(); ProgressView() }
+                } else if tool.appIDs.isEmpty {
+                    Text("This account has no App IDs.").foregroundStyle(.secondary)
+                }
+                ForEach(tool.appIDs) { item in
+                    HStack {
+                        VStack(alignment: .leading, spacing: 2) {
+                            Text(item.identifier == MemoryLimitTool.ownIdentifier ? String(localized: "Madeira (this app)") : item.name)
+                            Text(item.identifier).font(.caption).foregroundStyle(.secondary).lineLimit(1).truncationMode(.middle)
+                        }
+                        Spacer()
+                        if tool.enabled.contains(item.identifier) {
+                            Image(systemName: "checkmark.circle.fill").foregroundStyle(.green)
+                                .accessibilityLabel("Turned on")
+                        } else if tool.enabling.contains(item.identifier) {
+                            ProgressView()
+                        } else {
+                            Button("Turn on") { tool.enable(item) }.buttonStyle(.borderless)
+                        }
+                    }
+                }
+            } header: {
+                Text("App IDs")
+            } footer: {
+                VStack(alignment: .leading, spacing: 8) {
+                    if !tool.loadingAppIDs, !tool.appIDs.isEmpty,
+                       !tool.appIDs.contains(where: { $0.identifier == MemoryLimitTool.ownIdentifier }) {
+                        Text("Madeira's App ID (\(MemoryLimitTool.ownIdentifier)) is not in this team. Sign in with the Apple ID you sideloaded Madeira with.")
+                    }
+                    Text("After turning it on, reinstall or refresh Madeira from SideStore, AltStore or Sideloadly, so its new provisioning profile carries the capability. Memory+ then shows a green check.")
+                }
+            }
+        }
+    }
+}
