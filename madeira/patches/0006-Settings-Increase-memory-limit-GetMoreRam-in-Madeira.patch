+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+//
+// Vendored from Impactor (github.com/khcrysalis/Impactor @ c7f8387),
+// crates/plume_core/src/auth/account/login.rs (plume_core, MPL-2.0). Changed for Madeira: module paths; a server proof that
+// does not verify is an error, not a panic.
+
+use crate::appleid::anisette::AnisetteConfiguration;
+use plist::{Dictionary, Value};
+use reqwest::header::{HeaderMap, HeaderValue};
+use sha2::{Digest, Sha256};
+use srp::groups::G2048;
+
+use crate::appleid::plume::Error;
