+// SPDX-License-Identifier: GPL-3.0-or-later
+// Madeira Converter Exception: see LICENSE-EXCEPTION.md
+//
+// Importing a Windows program packed as a .zip or .7z archive: the library's +
+// menu picks the archive in Files, MadeiraArchive.c extracts it into
+// drive_c/Programs/<name>, and the program's executable becomes a library
+// entry (found on its own when there is one obvious choice, otherwise picked
+// from a list).
+
+import os
+import SwiftUI
+import UniformTypeIdentifiers
+
+enum ArchiveImport {
+    static let types: [UTType] = [.zip, UTType(filenameExtension: "7z") ?? .data]
+
+    /// Imported programs live here, as C:\Programs\<name>.
+    static var programs: URL { LibraryModel.drive.appendingPathComponent("Programs", isDirectory: true) }
+
+    struct Failure: LocalizedError {
+        let code: Int
+        let detail: String
+        var errorDescription: String? {
+            let text: String
+            switch code {
+            case Int(MA_ERR_OPEN): text = String(localized: "The archive could not be read.")
+            case Int(MA_ERR_FORMAT): text = String(localized: "This is not a zip or 7z archive, or the archive is damaged.")
+            case Int(MA_ERR_UNSUPPORTED): text = String(localized: "The archive uses a compression method Madeira cannot unpack, or its file names are encrypted.")
+            case Int(MA_ERR_ENCRYPTED): text = String(localized: "The archive is password-protected. Unpack it on a computer and pack it again without a password.")
+            case Int(MA_ERR_WRITE): text = String(localized: "Writing the files failed. Is the storage full?")
+            case Int(MA_ERR_UNSAFE_PATH): text = String(localized: "The archive contains a file that would be written outside its folder, so it was not imported.")
+            case Int(MA_ERR_NOMEM): text = String(localized: "There was not enough memory to unpack the archive.")
+            case Int(MA_ERR_CRC): text = String(localized: "The archive is damaged: a file does not match its checksum.")
+            case Int(MA_ERR_TOO_LARGE): text = String(localized: "This 7z archive needs more memory to unpack than is available. Pack it again as a zip, or as a 7z with a smaller dictionary.")
+            default: text = String(localized: "Unpacking failed.")
+            }
+            return detail.isEmpty ? text : "\(text)\n(\(detail))"
+        }
+    }
+
+    struct Cancelled: Error {}
+
+    private final class ProgressBox {
+        let report: (Double) -> Bool
+        init(_ report: @escaping (Double) -> Bool) { self.report = report }
+    }
+
+    /// Unpacks `archive` into a new folder under Programs and returns it.
+    /// `progress` gets 0...1 and returns false to cancel. Runs on the calling
+    /// thread; call it off the main thread.
+    static func extract(_ archive: URL, progress: @escaping (Double) -> Bool) throws -> URL {
+        let fm = FileManager.default
+        try fm.createDirectory(at: programs, withIntermediateDirectories: true)
+        let staging = programs.appendingPathComponent(".importing-\(UUID().uuidString)", isDirectory: true)
+        try fm.createDirectory(at: staging, withIntermediateDirectories: true)
+        var keep = false
+        defer { if !keep { try? fm.removeItem(at: staging) } }
+
+        let box = ProgressBox(progress)
+        let ctx = Unmanaged.passRetained(box).toOpaque()
+        defer { Unmanaged<ProgressBox>.fromOpaque(ctx).release() }
+        var detail = [CChar](repeating: 0, count: 512)
+        // A block that cannot be streamed may take up to about half of what is
+        // left to this app; LZMA dictionaries always get at least 256 MB.
+        let available = UInt64(os_proc_available_memory())
+        let limit = available > 0 ? available / 2 : 0
+        let rc = ma_extract(archive.path, staging.path, limit, { ctx, done, total in
+            guard let ctx else { return 0 }
+            let box = Unmanaged<ProgressBox>.fromOpaque(ctx).takeUnretainedValue()
+            return box.report(total > 0 ? Double(done) / Double(total) : 0) ? 0 : 1
+        }, ctx, &detail, detail.count)
+        if Int(rc) == Int(MA_ERR_CANCELLED) { throw Cancelled() }
+        guard Int(rc) == Int(MA_OK) else {
+            throw Failure(code: Int(rc), detail: String(cString: detail))
+        }
+
+        // An archive holding one folder (the usual "Game/..." layout) becomes
+        // that folder; anything else becomes a folder named after the archive.
+        let top = (try? fm.contentsOfDirectory(at: staging, includingPropertiesForKeys: [.isDirectoryKey],
+                                               options: .skipsHiddenFiles)) ?? []
+        let source: URL, name: String
+        if top.count == 1, top[0].hasDirectoryPath {
+            source = top[0]; name = top[0].lastPathComponent
+        } else {
+            source = staging; name = archive.deletingPathExtension().lastPathComponent
+        }
+        let target = uniqueFolder(named: name)
+        try fm.moveItem(at: source, to: target)
+        if source != staging { try? fm.removeItem(at: staging) } else { keep = true }
+        return target
+    }
+
+    private static func uniqueFolder(named raw: String) -> URL {
+        let name = raw.trimmingCharacters(in: .whitespacesAndNewlines).isEmpty ? "Program" : raw
+        var url = programs.appendingPathComponent(name, isDirectory: true)
+        var n = 2
+        while FileManager.default.fileExists(atPath: url.path) {
+            url = programs.appendingPathComponent("\(name) \(n)", isDirectory: true)
+            n += 1
+        }
+        return url
+    }
+
+    /// Words in file names that mark an executable as something other than the
+    /// program itself: installers, uninstallers, redistributables, crash handlers.
+    private static let helperWords = ["unins", "uninst", "setup", "install", "vcredist", "vc_redist", "dxsetup",
+                                      "directx", "dotnet", "ndp4", "redist", "crashhandler", "crashreport",
+                                      "crashpad", "updater", "update", "prereq", "launcherhelper", "bugreport",
+                                      "cefprocess", "webhelper", "helper"]
+
+    struct Candidate: Identifiable {
+        let url: URL
+        let relative: String
+        let likelyHelper: Bool
+        var id: String { relative }
+    }
+
+    /// The programs and batch files in `folder`, the likeliest first: not a
+    /// helper, an .exe, near the top, the largest.
+    static func candidates(in folder: URL) -> [Candidate] {
+        let fm = FileManager.default
+        guard let walker = fm.enumerator(at: folder, includingPropertiesForKeys: [.fileSizeKey, .isRegularFileKey],
+                                         options: [.skipsHiddenFiles]) else { return [] }
+        var found: [(Candidate, depth: Int, size: Int, exe: Bool)] = []
+        for case let url as URL in walker {
+            let ext = url.pathExtension.lowercased()
+            guard LibraryModel.programExtensions.contains(ext) else { continue }
+            let relative = String(url.path.dropFirst(folder.path.count + 1))
+            let lower = url.lastPathComponent.lowercased()
+            let helper = helperWords.contains { lower.contains($0) }
+            let size = (try? url.resourceValues(forKeys: [.fileSizeKey]).fileSize) ?? 0
+            found.append((Candidate(url: url, relative: relative, likelyHelper: helper),
+                          relative.split(separator: "/").count, size, ext == "exe"))
+        }
+        return found.sorted { a, b in
+            if a.0.likelyHelper != b.0.likelyHelper { return !a.0.likelyHelper }
+            if a.exe != b.exe { return a.exe }
+            if a.depth != b.depth { return a.depth < b.depth }
+            return a.size > b.size
+        }.map(\.0)
+    }
+}
+
+/// Set on the main thread, read by the extraction thread.
+final class ImportCancelFlag: @unchecked Sendable {
+    private let lock = NSLock()
+    private var value = false
+    var isSet: Bool { lock.lock(); defer { lock.unlock() }; return value }
+    func set() { lock.lock(); value = true; lock.unlock() }
+}
+
+/// The state of one import, shown over the library.
+@MainActor
+final class ArchiveImporter: ObservableObject {
+    enum Phase {
+        case idle
+        case extracting(name: String, progress: Double)
+        case choosing(folder: URL, candidates: [ArchiveImport.Candidate])
+    }
+    @Published var phase: Phase = .idle
+    @Published var error: String?
+    private var cancelFlag = ImportCancelFlag()
+
+    var isActive: Bool { if case .idle = phase { return false } else { return true } }
+
+    func start(_ archive: URL, save: @escaping (LibraryEntry) -> Void) {
+        guard !isActive else { return }
+        let flag = ImportCancelFlag()
+        cancelFlag = flag
+        let name = archive.lastPathComponent
+        phase = .extracting(name: name, progress: 0)
+        Task.detached(priority: .userInitiated) { [weak self] in
+            let scoped = archive.startAccessingSecurityScopedResource()
+            defer { if scoped { archive.stopAccessingSecurityScopedResource() } }
+            var lastShown = -1.0
+            let result: Result<URL, Error>
+            // Reading through a file coordinator downloads an iCloud archive first.
+            var coordinationError: NSError?
+            var extracted: Result<URL, Error> = .failure(ArchiveImport.Failure(code: Int(MA_ERR_OPEN), detail: ""))
+            NSFileCoordinator().coordinate(readingItemAt: archive, options: [], error: &coordinationError) { url in
+                extracted = Result {
+                    try ArchiveImport.extract(url) { fraction in
+                        if fraction - lastShown >= 0.01 || fraction >= 1 {
+                            lastShown = fraction
+                            Task { @MainActor [weak self] in
+                                if case .extracting = self?.phase { self?.phase = .extracting(name: name, progress: fraction) }
+                            }
+                        }
+                        return !flag.isSet
+                    }
+                }
+            }
+            if let coordinationError { result = .failure(coordinationError) } else { result = extracted }
+            await self?.finish(result, save: save)
+        }
+    }
+
+    func cancel() { cancelFlag.set() }
+
+    private func finish(_ result: Result<URL, Error>, save: @escaping (LibraryEntry) -> Void) {
+        switch result {
+        case .failure(let error):
+            phase = .idle
+            if !(error is ArchiveImport.Cancelled) { self.error = error.localizedDescription }
+        case .success(let folder):
+            let list = ArchiveImport.candidates(in: folder)
+            let programs = list.filter { !$0.likelyHelper && $0.url.pathExtension.lowercased() == "exe" }
+            if programs.count == 1, let entry = try? Self.entry(for: programs[0].url, in: folder) {
+                phase = .idle
+                save(entry)
+            } else if list.isEmpty {
+                phase = .idle
+                error = String(localized: "The archive was unpacked to C:\\Programs\\\(folder.lastPathComponent), but it contains no .exe, .bat or .cmd file.")
+            } else {
+                phase = .choosing(folder: folder, candidates: list)
+            }
+        }
+    }
+
+    /// The library entry for `exe`, titled after its folder.
+    static func entry(for exe: URL, in folder: URL) throws -> LibraryEntry {
+        var entry = try LibraryModel.inspect(exe)
+        entry.title = folder.lastPathComponent
+        return entry
+    }
+
+    func choose(_ candidate: ArchiveImport.Candidate, folder: URL, save: (LibraryEntry) -> Void) {
+        do {
+            save(try Self.entry(for: candidate.url, in: folder))
+            phase = .idle
+        } catch {
+            self.error = error.localizedDescription
+        }
+    }
+
+    func dismissChoice() { phase = .idle }
+}
+
+/// Unpacking progress, over the library while an import runs.
+struct ArchiveImportProgress: View {
+    @ObservedObject var importer: ArchiveImporter
+    var body: some View {
+        if case .extracting(let name, let progress) = importer.phase {
+            VStack(spacing: 14) {
+                Label("Unpacking", systemImage: "archivebox").font(.headline)
+                Text(name).font(.subheadline).foregroundStyle(.secondary).lineLimit(1).truncationMode(.middle)
+                ProgressView(value: progress).frame(width: 240)
+                Text(progress, format: .percent.precision(.fractionLength(0))).monospacedDigit().foregroundStyle(.secondary)
+                Button("Cancel", role: .cancel) { importer.cancel() }
+            }
+            .padding(24)
+            .background(.regularMaterial, in: RoundedRectangle(cornerRadius: 24))
+            .shadow(radius: 20)
+        }
+    }
+}
+
+/// Picking the executable after an import that has more than one candidate.
+struct ArchiveProgramPicker: View {
+    let folder: URL
+    let candidates: [ArchiveImport.Candidate]
+    var choose: (ArchiveImport.Candidate) -> Void
+    /// An executable chosen by browsing the unpacked folder.
+    var browseSelect: (LibraryEntry) -> Void
+    var cancel: () -> Void
+    var body: some View {
+        NavigationStack {
+            List {
+                Section {
+                    ForEach(candidates) { c in
+                        Button { choose(c) } label: {
+                            Label {
+                                VStack(alignment: .leading, spacing: 2) {
+                                    Text(c.url.lastPathComponent)
+                                    Text(c.relative).font(.caption).foregroundStyle(.secondary)
+                                }
+                            } icon: {
+                                Image(systemName: c.likelyHelper ? "gearshape" : c.url.pathExtension.lowercased() == "exe" ? "app.dashed" : "terminal")
+                            }
+                        }
+                    }
+                } footer: {
+                    Text("Unpacked to C:\\Programs\\\(folder.lastPathComponent). Installers and uninstallers are listed last.")
+                }
+                Section {
+                    NavigationLink {
+                        ExecutableBrowser(folder: folder) { entry in
+                            var entry = entry
+                            entry.title = folder.lastPathComponent
+                            browseSelect(entry)
+                        }
+                    } label: { Label("Browse all files", systemImage: "folder") }
+                }
+            }
+            .navigationTitle("Choose the program")
+            .toolbar { ToolbarItem(placement: .cancellationAction) { Button("Later", action: cancel) } }
+        }
+    }
+}
